# Entorno: development | test | production
NODE_ENV=test
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://inventario:inventario@localhost:5432/inventario_test?schema=public

# JWT (usa cadenas largas y aleatorias en producción: `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Límite de peticiones por IP (ventana en minutos)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10000

LOG_LEVEL=silent
